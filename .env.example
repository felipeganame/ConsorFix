# --- App ---
NODE_ENV=development
LOG_LEVEL=info

# --- API ---
API_PORT=3000
API_HOST=0.0.0.0
API_URL=http://localhost:3000
JWT_SECRET=change-me-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
INTERNAL_TOKEN=worker-secret-token

# --- Database (RLS app role, NOT owner) ---
DATABASE_URL=postgres://app_user:app_pass@localhost:5433/consorciofix
DATABASE_OWNER_URL=postgres://owner_user:owner_pass@localhost:5433/consorciofix

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379
QUEUE_DISABLED=0
WORKER_CONCURRENCY=4

# --- Object storage (MinIO in dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=consorciofix-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- WhatsApp Cloud (Meta) ---
WHATSAPP_PROVIDER=mock
WHATSAPP_VERIFY_TOKEN=verify-me
WHATSAPP_APP_SECRET=app-secret-for-signature
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_MOCK_URL=http://localhost:8081

# --- AI Providers (multi-LLM) ---
# Master default — usado cuando no se setea provider específico por capacidad.
AI_PROVIDER=mock

# Overrides por capacidad — permiten mezclar proveedores.
# Valores: mock | openai | anthropic | google | voyage (según capacidad)
AI_CLASSIFIER_PROVIDER=mock   # mock | openai | anthropic | google
AI_EMBEDDER_PROVIDER=mock     # mock | openai | voyage
AI_TRANSCRIBER_PROVIDER=mock  # mock | openai
AI_VISION_PROVIDER=mock       # mock | openai | anthropic

# Modelos (opcional — defaults razonables por provider).
AI_CLASSIFIER_MODEL=          # ej. gpt-4o-mini | claude-3-5-haiku-latest | gemini-1.5-flash
AI_EMBEDDER_MODEL=            # ej. text-embedding-3-small | voyage-3-lite
AI_TRANSCRIBER_MODEL=         # ej. whisper-1
AI_VISION_MODEL=              # ej. gpt-4o-mini | claude-3-5-haiku-latest

# Dedup similarity threshold (cosine). Default 0.85 con OpenAI, 0.55 con mock.
DEDUP_THRESHOLD=

# --- API keys (cargar las del proveedor que uses) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
VOYAGE_API_KEY=

# --- Observability ---
SENTRY_DSN=

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:3000
