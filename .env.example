# --- App ---
NODE_ENV=development
LOG_LEVEL=info

# --- API ---
API_PORT=3000
API_HOST=0.0.0.0
API_URL=http://localhost:3000
JWT_SECRET=change-me-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
INTERNAL_TOKEN=worker-secret-token

# --- Database (RLS app role, NOT owner) ---
DATABASE_URL=postgres://app_user:app_pass@localhost:5433/consorciofix
DATABASE_OWNER_URL=postgres://owner_user:owner_pass@localhost:5433/consorciofix

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379
QUEUE_DISABLED=0
WORKER_CONCURRENCY=4

# --- Object storage (MinIO in dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=consorciofix-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- WhatsApp Cloud (Meta) ---
WHATSAPP_PROVIDER=mock
WHATSAPP_VERIFY_TOKEN=verify-me
WHATSAPP_APP_SECRET=app-secret-for-signature
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_MOCK_URL=http://localhost:8081

# --- AI Providers (multi-LLM) ---
# Master default — usado cuando no se setea provider específico por capacidad.
AI_PROVIDER=mock

# Overrides por capacidad — permiten mezclar proveedores.
# Valores: mock | openai | anthropic | google | voyage (según capacidad)
AI_CLASSIFIER_PROVIDER=mock   # mock | openai | anthropic | google
AI_EMBEDDER_PROVIDER=mock     # mock | openai | voyage
AI_TRANSCRIBER_PROVIDER=mock  # mock | openai
AI_VISION_PROVIDER=mock       # mock | openai | anthropic

# Modelos (opcional — defaults razonables por provider).
AI_CLASSIFIER_MODEL=          # ej. gpt-4o-mini | claude-haiku-4-5-20251001 | gemini-2.0-flash
AI_EMBEDDER_MODEL=            # text-embedding-3-small (debe soportar dimensions=384)
AI_TRANSCRIBER_MODEL=         # ej. whisper-1
AI_VISION_MODEL=              # ej. gpt-4o-mini | claude-haiku-4-5-20251001

# Base URLs — para apuntar los adaptadores al mock local (mock-ai:8082) o a un
# proxy. Vacías usan las oficiales de cada proveedor.
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
GOOGLE_BASE_URL=

# Reintentos ante errores transitorios del proveedor (429, 5xx). Default 2.
AI_MAX_RETRIES=

# Dedup similarity threshold (cosine). Default 0.85 con OpenAI, 0.55 con mock.
DEDUP_THRESHOLD=

# --- API keys (cargar las del proveedor que uses) ---
# Para pasar a IA real alcanza con OPENAI_API_KEY + AI_PROVIDER=openai:
# cubre clasificación, embeddings, transcripción (Whisper) y visión.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# VOYAGE está DESACTIVADO: el modelo no soporta output_dimension=384 y el
# adaptador truncaba el vector, rompiendo el coseno del dedup. La factory cae a
# mock con un warning si se lo elige. Ver packages/ai/README.md.
VOYAGE_API_KEY=

# --- Observability ---
SENTRY_DSN=

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- Telegram (canal alternativo a WhatsApp) ---
# Crear el bot con @BotFather y registrar el webhook con setWebhook pasando
# `secret_token`. A diferencia de WhatsApp no hay verificacion de Meta Business,
# ni numero productivo, ni plantillas HSM, ni ventana de 24h.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Canal por defecto para notificaciones salientes: whatsapp | telegram.
# La RECEPCION funciona por ambos canales a la vez, sin importar este valor.
MESSAGING_PROVIDER=whatsapp

# --- Notificaciones ---
# El reaper reintenta las notificaciones que quedaron colgadas (PENDIENTE o
# FALLIDA) con backoff 1/5/15/60/240 min. Ponerlo en 1 lo apaga (util en tests).
NOTIF_REAPER_DISABLED=
NOTIF_REAPER_INTERVAL_MS=60000
