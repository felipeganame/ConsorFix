{
  "name": "@consorciofix/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:isolation": "vitest run -c vitest.isolation.config.ts",
    "db:migrate": "node scripts/migrate.cjs",
    "seed": "node scripts/seed.cjs",
    "clean": "rm -rf dist .turbo",
    "test:coverage": "vitest run -c vitest.integration.config.ts --coverage",
    "demo": "tsx scripts/demo-flujo-minimo.ts",
    "bot": "tsx scripts/bot-simular.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@consorciofix/ai": "workspace:*",
    "@consorciofix/contracts": "workspace:*",
    "@consorciofix/domain": "workspace:*",
    "@consorciofix/messaging": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/throttler": "^6.5.0",
    "argon2": "^0.41.0",
    "bullmq": "^5.13.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.0",
    "papaparse": "^5.6.0",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.0",
    "@swc/core": "^1.16.0",
    "@types/express": "^5.0.6",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.9",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.0.0",
    "testcontainers": "^10.13.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0"
  }
}
