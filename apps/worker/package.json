{
  "name": "@consorciofix/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@consorciofix/ai": "workspace:*",
    "@consorciofix/contracts": "workspace:*",
    "@consorciofix/domain": "workspace:*",
    "@consorciofix/messaging": "workspace:*",
    "bullmq": "^5.13.0",
    "ioredis": "^5.4.1",
    "pino": "^9.4.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
