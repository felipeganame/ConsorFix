{
  "name": "consorciofix",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:isolation": "turbo run test:isolation --filter=@consorciofix/api",
    "db:migrate": "turbo run db:migrate --filter=@consorciofix/api",
    "seed": "turbo run seed --filter=@consorciofix/api",
    "ai:eval": "turbo run ai:eval --filter=@consorciofix/ai",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:coverage": "turbo run test:coverage",
    "demo": "pnpm --filter @consorciofix/api demo",
    "bot": "pnpm --filter @consorciofix/api bot"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.14.0",
    "eslint": "^9.10.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.61.0"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.2.0"
    }
  }
}
