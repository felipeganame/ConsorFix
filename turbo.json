{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local",
    "tsconfig.base.json"
  ],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DATABASE_OWNER_URL",
    "JWT_SECRET",
    "JWT_ACCESS_TTL",
    "JWT_REFRESH_TTL",
    "REDIS_URL",
    "API_PORT",
    "API_HOST",
    "API_URL",
    "LOG_LEVEL",
    "INTERNAL_TOKEN",
    "WORKER_CONCURRENCY",
    "QUEUE_DISABLED",
    "DEDUP_THRESHOLD",
    "WHATSAPP_PROVIDER",
    "WHATSAPP_MOCK_URL",
    "WHATSAPP_VERIFY_TOKEN",
    "WHATSAPP_APP_SECRET",
    "WHATSAPP_ACCESS_TOKEN",
    "WHATSAPP_PHONE_NUMBER_ID",
    "AI_PROVIDER",
    "AI_CLASSIFIER_PROVIDER",
    "AI_CLASSIFIER_MODEL",
    "AI_EMBEDDER_PROVIDER",
    "AI_EMBEDDER_MODEL",
    "AI_TRANSCRIBER_PROVIDER",
    "AI_TRANSCRIBER_MODEL",
    "AI_VISION_PROVIDER",
    "AI_VISION_MODEL",
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_BASE_URL",
    "GOOGLE_API_KEY",
    "GOOGLE_BASE_URL",
    "VOYAGE_API_KEY",
    "EXPO_ACCESS_TOKEN",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_WEBHOOK_SECRET",
    "MESSAGING_PROVIDER",
    "AI_MAX_RETRIES"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "test:isolation": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "seed": {
      "cache": false
    },
    "ai:eval": {
      "cache": false,
      "outputs": [
        "eval-results/**"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
